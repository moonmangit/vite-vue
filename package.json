{
  "name": "vite-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:all": "pnpm format:check && pnpm lint && pnpm check:convention",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:convention": "node scripts/check-architecture.mjs",
    "check:convention:app": "node scripts/check-architecture.mjs app",
    "check:convention:shared": "node scripts/check-architecture.mjs shared",
    "check:convention:feature": "node scripts/check-architecture.mjs feature",
    "format": "prettier --write .",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "fix:all": "pnpm format:fix && pnpm lint:fix && pnpm check:convention",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "@vueuse/core": "^14.3.0",
    "apexcharts": "^5.16.0",
    "axios": "^1.18.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
